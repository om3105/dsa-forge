# Firebase web config for project dsa-forge-2026 (these identify the project; they are not secrets —
# access is enforced by Firebase Auth + firestore.rules)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Cloud code runner (runner/). Leave empty to use a local Piston at http://localhost:2000.
VITE_RUNNER_URL=

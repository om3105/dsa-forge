{
  "name": "dsa-forge",
  "version": "1.0.0",
  "description": "DSA Forge - personal DSA learning app (Python & Java courses)",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "verify:problems": "tsx scripts/verify-problems.ts",
    "fetch:tools-jar": "bash scripts/fetch-tools-jar.sh",
    "gen:expected": "tsx scripts/gen-expected.ts",
    "build:loader": "T=$(mktemp -d) && javac --release 8 -nowarn -d $T scripts/cheerpj/DsaLoader.java && (cd $T && jar cf \"$OLDPWD/public/cheerpj/dsaloader.jar\" DsaLoader.class)",
    "verify:map": "tsx scripts/verify-map.ts"
  },
  "type": "module",
  "dependencies": {
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "@fontsource/ibm-plex-serif": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@fontsource/urbanist": "^5.3.0",
    "@monaco-editor/react": "^4.7.0",
    "firebase": "^13.1.0",
    "idb-keyval": "^6.3.0",
    "lucide-react": "^1.63.0",
    "monaco-editor": "^0.57.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.30.6"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^6.1.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.5"
  },
  "private": true
}
